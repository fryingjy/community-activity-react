{
  "manifest_version": 3,
  "name": "Community Activity",
  "version": "5.17.3",
  "description": "Scan an X Community roster for inactive members and export a CSV.",
  "minimum_chrome_version": "114",
  "permissions": ["cookies", "storage", "unlimitedStorage", "scripting", "sidePanel", "webRequest"],
  "host_permissions": ["https://x.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Community Activity"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
